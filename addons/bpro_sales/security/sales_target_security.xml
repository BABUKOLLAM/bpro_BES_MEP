<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_sales_target_own_only" model="ir.rule">
        <field name="name">bpro Sales Target: Own Only (Salesman)</field>
        <field name="model_id" ref="model_bpro_sales_target"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_sales_target_manager_all" model="ir.rule">
        <field name="name">bpro Sales Target: All (Sales Manager)</field>
        <field name="model_id" ref="model_bpro_sales_target"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
