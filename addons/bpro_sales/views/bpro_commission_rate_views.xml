<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpro_commission_rate_list" model="ir.ui.view">
        <field name="name">bpro.commission.rate.list</field>
        <field name="model">bpro.commission.rate</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="user_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="commission_pct"/>
            </list>
        </field>
    </record>

    <record id="action_bpro_commission_rate" model="ir.actions.act_window">
        <field name="name">Commission Rates</field>
        <field name="res_model">bpro.commission.rate</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_bpro_commission_rate" name="Commission Rates"
              parent="sale.menu_sale_config" action="action_bpro_commission_rate"
              groups="sales_team.group_sale_manager" sequence="60"/>

    <record id="view_bpro_sale_order_commission_pivot" model="ir.ui.view">
        <field name="name">sale.order.commission.pivot</field>
        <field name="model">sale.order</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="user_id" type="row"/>
                <field name="date_order" type="col" interval="month"/>
                <field name="bpro_commission_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_bpro_sale_order_commission_report" model="ir.actions.act_window">
        <field name="name">Commission Report</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[("state", "=", "sale")]</field>
        <field name="context">{"pivot_measures": ["bpro_commission_amount"]}</field>
    </record>

    <menuitem id="menu_bpro_sale_order_commission_report" name="Commission Report"
              parent="sale.menu_sale_report" action="action_bpro_sale_order_commission_report"
              sequence="16"/>
</odoo>
