<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_bpro_approval" model="ir.ui.view">
        <field name="name">sale.order.form.bpro.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="approval_state" invisible="1"/>
                <button name="action_approve" type="object" string="Approve Discount"
                        invisible="approval_state != 'pending'" class="btn-primary"
                        groups="sales_team.group_sale_manager"/>
                <button name="action_reject" type="object" string="Reject Discount"
                        invisible="approval_state != 'pending'"
                        groups="sales_team.group_sale_manager"/>
            </xpath>
            <xpath expr="//form/header" position="after">
                <div class="alert alert-warning" role="alert"
                     invisible="approval_state != 'pending'">
                    This order's discount exceeds the approval threshold and is
                    pending Sales Manager approval.
                </div>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="sales_area_id"/>
            </xpath>
            <xpath expr="//page[@name='other_information']//group[@name='sale_info']" position="after">
                <group name="bpro_commission" string="Commission">
                    <field name="bpro_commission_pct" readonly="1"/>
                    <field name="bpro_commission_amount" readonly="1"/>
                </group>
                <group name="bpro_recurrence" string="Recurring Order">
                    <field name="bpro_is_recurring"/>
                    <field name="bpro_recurrence_interval" invisible="not bpro_is_recurring"
                           required="bpro_is_recurring"/>
                    <field name="bpro_next_recurrence_date" readonly="1"
                           invisible="not bpro_is_recurring"/>
                    <field name="bpro_recurring_parent_id" readonly="1"
                           invisible="not bpro_recurring_parent_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
