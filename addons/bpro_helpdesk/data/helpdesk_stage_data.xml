<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="helpdesk_stage_new" model="bpro.helpdesk.stage">
        <field name="name">New</field>
        <field name="sequence">10</field>
    </record>
    <record id="helpdesk_stage_in_progress" model="bpro.helpdesk.stage">
        <field name="name">In Progress</field>
        <field name="sequence">20</field>
    </record>
    <record id="helpdesk_stage_resolved" model="bpro.helpdesk.stage">
        <field name="name">Resolved</field>
        <field name="sequence">30</field>
        <field name="is_closed">True</field>
    </record>
    <record id="helpdesk_stage_closed" model="bpro.helpdesk.stage">
        <field name="name">Closed</field>
        <field name="sequence">40</field>
        <field name="is_closed">True</field>
        <field name="fold">True</field>
    </record>
</odoo>
