<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpro_helpdesk_stage_list" model="ir.ui.view">
        <field name="name">bpro.helpdesk.stage.list</field>
        <field name="model">bpro.helpdesk.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_closed"/>
                <field name="fold"/>
            </list>
        </field>
    </record>

    <record id="action_bpro_helpdesk_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">bpro.helpdesk.stage</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_bpro_helpdesk_stage" name="Stages"
              parent="menu_bpro_helpdesk_config" action="action_bpro_helpdesk_stage"
              sequence="20"/>
</odoo>
