<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Content visibility: own/allowed companies + parent (global) content.
         'parent_of' matches when the course's owner company is an ancestor of
         (or equal to) the user's company — so bpro Corporate courses are
         visible to every client company underneath it. -->
    <record id="rule_slide_channel_company" model="ir.rule">
        <field name="name">LMS Course: Own Company or Global (parent)</field>
        <field name="model_id" ref="website_slides.model_slide_channel"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_employee'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', [user.company_id.id])]</field>
    </record>

    <record id="rule_slide_channel_super" model="ir.rule">
        <field name="name">LMS Course: Super Admin All</field>
        <field name="model_id" ref="website_slides.model_slide_channel"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
