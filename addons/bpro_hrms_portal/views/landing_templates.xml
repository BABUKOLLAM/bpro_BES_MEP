<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="landing_page" name="bpro HCM HRMS Suite Pro — Landing">
        <t t-call="web.frontend_layout">
            <t t-set="html_data" t-value="{'style': 'scroll-behavior: smooth;'}"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <t t-set="pageName" t-value="'bpro_hrms_landing'"/>

            <div class="bpro-landing">

                <!-- ============ NAV ============ -->
                <nav class="bpro-nav" id="bproNav">
                    <div class="bpro-nav-inner">
                        <a href="/" class="bpro-nav-brand">
                            <span class="bpro-logo-mark">b</span>
                            <span class="bpro-logo-text">bpro <strong>HCM</strong> <span class="bpro-logo-divider">|</span> HRMS</span>
                        </a>
                        <div class="bpro-nav-links d-none d-md-flex">
                            <a href="#modules">Modules</a>
                            <a href="#lifecycle">Lifecycle</a>
                            <a href="#compliance">Compliance</a>
                        </div>
                        <a href="/web/login" class="bpro-btn bpro-btn-nav">
                            Sign in <i class="fa fa-arrow-right ms-2"/>
                        </a>
                    </div>
                </nav>

                <!-- ============ HERO ============ -->
                <header class="bpro-hero">
                    <div class="bpro-hero-bg">
                        <div class="bpro-orb bpro-orb-1"/>
                        <div class="bpro-orb bpro-orb-2"/>
                        <div class="bpro-orb bpro-orb-3"/>
                        <div class="bpro-grid-overlay"/>
                    </div>
                    <div class="bpro-hero-inner">
                        <div class="bpro-hero-copy">
                            <div class="bpro-eyebrow bpro-reveal">
                                <span class="bpro-pulse-dot"/>
                                HRMS SUITE PRO
                            </div>
                            <h1 class="bpro-reveal" data-delay="100">
                                Every person.<br/>
                                Every process.<br/>
                                <span class="bpro-gradient-text">One platform.</span>
                            </h1>
                            <p class="bpro-hero-sub bpro-reveal" data-delay="200">
                                bpro HCM runs the complete employee lifecycle — from the
                                vacancy request to the final settlement — with India-ready
                                payroll compliance built in, not bolted on.
                            </p>
                            <div class="bpro-hero-actions bpro-reveal" data-delay="300">
                                <a href="/web/login" class="bpro-btn bpro-btn-primary">
                                    Sign in to your workspace <i class="fa fa-arrow-right ms-2"/>
                                </a>
                                <a href="#modules" class="bpro-btn bpro-btn-ghost">
                                    Explore the suite
                                </a>
                            </div>
                        </div>

                        <!-- Floating product mock: pure CSS, no images -->
                        <div class="bpro-hero-visual bpro-reveal" data-delay="250">
                            <div class="bpro-mock bpro-float-1">
                                <div class="bpro-mock-header">
                                    <span class="bpro-mock-dot"/><span class="bpro-mock-dot"/><span class="bpro-mock-dot"/>
                                    <span class="bpro-mock-title">Payroll · August 2026</span>
                                </div>
                                <div class="bpro-mock-row">
                                    <span>Gross payout</span>
                                    <strong>₹ 48,20,400</strong>
                                </div>
                                <div class="bpro-mock-bar"><span style="width:86%"/></div>
                                <div class="bpro-mock-row">
                                    <span>PF · ESI · PT · LWF · TDS</span>
                                    <strong class="bpro-mock-ok"><i class="fa fa-check-circle me-1"/>Filed</strong>
                                </div>
                                <div class="bpro-mock-bar bpro-mock-bar-green"><span style="width:100%"/></div>
                            </div>
                            <div class="bpro-mock bpro-mock-sm bpro-float-2">
                                <div class="bpro-mock-kpi">
                                    <span class="bpro-mock-kpi-label">Attendance today</span>
                                    <span class="bpro-mock-kpi-value">96.4%</span>
                                </div>
                                <div class="bpro-spark">
                                    <span style="height:40%"/><span style="height:65%"/><span style="height:52%"/>
                                    <span style="height:78%"/><span style="height:70%"/><span style="height:92%"/>
                                    <span style="height:84%"/>
                                </div>
                            </div>
                            <div class="bpro-mock bpro-mock-chip bpro-float-3">
                                <i class="fa fa-user-plus"/>
                                <div>
                                    <strong>Offer accepted</strong>
                                    <span>EMP00214 · joins Sep 01</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="bpro-hero-scroll">
                        <span/>
                    </div>
                </header>

                <!-- ============ STATS ============ -->
                <section class="bpro-stats" id="compliance">
                    <div class="bpro-section-inner bpro-stats-grid">
                        <div class="bpro-stat bpro-reveal">
                            <div class="bpro-stat-value"><span class="bpro-count" data-target="12">0</span>+</div>
                            <div class="bpro-stat-label">Integrated modules</div>
                        </div>
                        <div class="bpro-stat bpro-reveal" data-delay="100">
                            <div class="bpro-stat-value"><span class="bpro-count" data-target="5">0</span></div>
                            <div class="bpro-stat-label">Statutory engines — PF · ESI · PT · LWF · TDS</div>
                        </div>
                        <div class="bpro-stat bpro-reveal" data-delay="200">
                            <div class="bpro-stat-value"><span class="bpro-count" data-target="100">0</span>%</div>
                            <div class="bpro-stat-label">Hire-to-retire coverage</div>
                        </div>
                        <div class="bpro-stat bpro-reveal" data-delay="300">
                            <div class="bpro-stat-value"><span class="bpro-count" data-target="357">0</span></div>
                            <div class="bpro-stat-label">Automated tests guarding every release</div>
                        </div>
                    </div>
                </section>

                <!-- ============ MODULES ============ -->
                <section class="bpro-modules" id="modules">
                    <div class="bpro-section-inner">
                        <div class="bpro-section-head bpro-reveal">
                            <span class="bpro-eyebrow-sm">THE SUITE</span>
                            <h2>Everything HR runs on, <span class="bpro-gradient-text">in one place</span></h2>
                            <p>Each module stands on the same core — one employee record,
                               one security model, one source of truth.</p>
                        </div>
                        <div class="bpro-module-grid">
                            <div class="bpro-card bpro-reveal">
                                <div class="bpro-card-icon"><i class="fa fa-sitemap"/></div>
                                <h3>Core HR</h3>
                                <p>Employee master, org structure, employment history and a
                                   four-tier security model scoped from employee to super admin.</p>
                            </div>
                            <div class="bpro-card bpro-reveal" data-delay="60">
                                <div class="bpro-card-icon"><i class="fa fa-inr"/></div>
                                <h3>Payroll — India</h3>
                                <p>CTC structures, PF, ESI, state-wise PT and LWF, new &amp; old
                                   regime TDS with Form 16 — computed, not copy-pasted.</p>
                            </div>
                            <div class="bpro-card bpro-reveal" data-delay="120">
                                <div class="bpro-card-icon"><i class="fa fa-briefcase"/></div>
                                <h3>Recruitment</h3>
                                <p>Vacancy requests, interview panels, tokenised offer portal,
                                   one-click hiring finalization with unique employee codes.</p>
                            </div>
                            <div class="bpro-card bpro-reveal" data-delay="180">
                                <div class="bpro-card-icon"><i class="fa fa-clock-o"/></div>
                                <h3>Attendance</h3>
                                <p>Punch-log imports from any device, automatic exception
                                   detection and HR review workflows.</p>
                            </div>
                            <div class="bpro-card bpro-reveal">
                                <div class="bpro-card-icon"><i class="fa fa-calendar-check-o"/></div>
                                <h3>Leave &amp; LOP</h3>
                                <p>India leave types out of the box, with loss-of-pay flowing
                                   straight into payroll proration — no spreadsheets between.</p>
                            </div>
                            <div class="bpro-card bpro-reveal" data-delay="60">
                                <div class="bpro-card-icon"><i class="fa fa-handshake-o"/></div>
                                <h3>Exit &amp; F&amp;F</h3>
                                <p>Separation workflows, clearance checklists and a full
                                   final-settlement statement, generated — not assembled.</p>
                            </div>
                            <div class="bpro-card bpro-reveal" data-delay="120">
                                <div class="bpro-card-icon"><i class="fa fa-mobile"/></div>
                                <h3>Employee Self-Service</h3>
                                <p>Payslips, leave, attendance and personal data in each
                                   employee's own hands — scoped to exactly what's theirs.</p>
                            </div>
                            <div class="bpro-card bpro-reveal" data-delay="180">
                                <div class="bpro-card-icon"><i class="fa fa-graduation-cap"/></div>
                                <h3>Learning &amp; Performance</h3>
                                <p>SCORM e-learning with auto-enrolled induction, competency
                                   maps, goals and appraisal cycles.</p>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ============ LIFECYCLE ============ -->
                <section class="bpro-lifecycle" id="lifecycle">
                    <div class="bpro-section-inner">
                        <div class="bpro-section-head bpro-reveal">
                            <span class="bpro-eyebrow-sm">HIRE TO RETIRE</span>
                            <h2>One unbroken thread</h2>
                            <p>Data entered once flows through every stage — nothing re-keyed,
                               nothing lost between systems.</p>
                        </div>
                        <div class="bpro-timeline">
                            <div class="bpro-tl-step bpro-reveal"><span class="bpro-tl-dot">1</span><strong>Request</strong><p>HOD raises a vacancy</p></div>
                            <div class="bpro-tl-step bpro-reveal" data-delay="80"><span class="bpro-tl-dot">2</span><strong>Hire</strong><p>Interview, offer, accept</p></div>
                            <div class="bpro-tl-step bpro-reveal" data-delay="160"><span class="bpro-tl-dot">3</span><strong>Onboard</strong><p>Joining SLA, assets, induction</p></div>
                            <div class="bpro-tl-step bpro-reveal" data-delay="240"><span class="bpro-tl-dot">4</span><strong>Work</strong><p>Attendance, leave, payroll</p></div>
                            <div class="bpro-tl-step bpro-reveal" data-delay="320"><span class="bpro-tl-dot">5</span><strong>Grow</strong><p>Learning, goals, appraisals</p></div>
                            <div class="bpro-tl-step bpro-reveal" data-delay="400"><span class="bpro-tl-dot">6</span><strong>Exit</strong><p>Clearance and F&amp;F, closed clean</p></div>
                        </div>
                    </div>
                </section>

                <!-- ============ CTA ============ -->
                <section class="bpro-cta">
                    <div class="bpro-cta-inner bpro-reveal">
                        <h2>Your workspace is ready.</h2>
                        <p>Sign in with your company credentials to continue.</p>
                        <a href="/web/login" class="bpro-btn bpro-btn-light">
                            Sign in <i class="fa fa-arrow-right ms-2"/>
                        </a>
                    </div>
                </section>

                <!-- ============ FOOTER ============ -->
                <footer class="bpro-footer">
                    <div class="bpro-section-inner bpro-footer-inner">
                        <span class="bpro-footer-brand">
                            <span class="bpro-logo-mark bpro-logo-mark-sm">b</span>
                            bpro HCM | HRMS
                        </span>
                        <span class="bpro-footer-note">
                            Developed by <a href="https://www.drbabu.in" target="_blank" rel="noopener">Dr. Babu</a>
                            &amp; <a href="https://www.bpropms.com" target="_blank" rel="noopener">bpro Technologies</a>
                        </span>
                    </div>
                </footer>
            </div>
        </t>
    </template>
</odoo>
