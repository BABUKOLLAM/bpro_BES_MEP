<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="bpro_pt_config_view_form" model="ir.ui.view">
        <field name="name">bpro.pt.config.form</field>
        <field name="model">bpro.pt.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="state_id"/>
                            <field name="periodicity"/>
                        </group>
                        <group invisible="periodicity != 'half_yearly'">
                            <field name="charge_month_h1"/>
                            <field name="charge_month_h2"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Jurisdiction caveats..."/>
                    <notebook>
                        <page string="Slabs" name="slabs">
                            <field name="slab_line_ids">
                                <list editable="bottom">
                                    <field name="lower_bound"/>
                                    <field name="upper_bound"/>
                                    <field name="amount"/>
                                    <field name="topup_month"/>
                                    <field name="topup_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bpro_pt_config_view_list" model="ir.ui.view">
        <field name="name">bpro.pt.config.list</field>
        <field name="model">bpro.pt.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="state_id"/>
                <field name="periodicity"/>
            </list>
        </field>
    </record>

    <record id="action_bpro_pt_config" model="ir.actions.act_window">
        <field name="name">Professional Tax — States</field>
        <field name="res_model">bpro.pt.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bpro_pt_config" name="Professional Tax States"
              parent="hr.menu_human_resources_configuration"
              action="action_bpro_pt_config"/>

</odoo>
