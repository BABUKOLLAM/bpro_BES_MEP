<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="bpro_tds_declaration_view_form" model="ir.ui.view">
        <field name="name">bpro.tds.declaration.form</field>
        <field name="model">bpro.tds.declaration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'submitted'" class="oe_highlight"
                            groups="hr.group_hr_manager"/>
                    <button name="action_reject" string="Reject" type="object"
                            invisible="state not in ('submitted', 'approved')"
                            groups="hr.group_hr_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'rejected'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="employee_id"/>
                            <field name="fy_start_year"/>
                        </group>
                        <group>
                            <field name="declared_80c"/>
                            <field name="declared_80d"/>
                            <field name="monthly_rent"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Supporting notes, proof references..."/>
                    <group invisible="not approved_by">
                        <field name="approved_by" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bpro_tds_declaration_view_list" model="ir.ui.view">
        <field name="name">bpro.tds.declaration.list</field>
        <field name="model">bpro.tds.declaration</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="fy_start_year"/>
                <field name="declared_80c"/>
                <field name="declared_80d"/>
                <field name="monthly_rent"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_bpro_tds_declaration" model="ir.actions.act_window">
        <field name="name">TDS Declarations</field>
        <field name="res_model">bpro.tds.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add an employee's investment declaration
            </p>
            <p>
                Only Approved declarations reduce TDS - Draft and
                Submitted have no effect on payroll, so an unreviewed
                claim never under-withholds tax.
            </p>
        </field>
    </record>

    <menuitem id="menu_bpro_tds_declaration" name="TDS Declarations"
              parent="hr.menu_human_resources_configuration"
              action="action_bpro_tds_declaration"/>

</odoo>
