<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="bpro_tds_regime_config_view_form" model="ir.ui.view">
        <field name="name">bpro.tds.regime.config.form</field>
        <field name="model">bpro.tds.regime.config</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="regime"/>
                            <field name="fy_start_year"/>
                        </group>
                        <group>
                            <field name="standard_deduction"/>
                            <field name="rebate_income_threshold"/>
                            <field name="rebate_max_amount"/>
                            <field name="cess_rate"/>
                        </group>
                    </group>
                    <field name="note" placeholder="Source, verification status..."/>
                    <notebook>
                        <page string="Slabs" name="slabs">
                            <field name="slab_line_ids">
                                <list editable="bottom">
                                    <field name="lower_bound"/>
                                    <field name="upper_bound"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="bpro_tds_regime_config_view_list" model="ir.ui.view">
        <field name="name">bpro.tds.regime.config.list</field>
        <field name="model">bpro.tds.regime.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="regime"/>
                <field name="fy_start_year"/>
                <field name="standard_deduction"/>
            </list>
        </field>
    </record>

    <record id="action_bpro_tds_regime_config" model="ir.actions.act_window">
        <field name="name">TDS — Regimes &amp; Slabs</field>
        <field name="res_model">bpro.tds.regime.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a financial year's tax slabs
            </p>
            <p>
                Tax slabs change nearly every Union Budget - add next
                year's New/Old Regime config here when it's announced,
                no code change needed.
            </p>
        </field>
    </record>

    <menuitem id="menu_bpro_tds_regime_config" name="TDS Regimes &amp; Slabs"
              parent="hr.menu_human_resources_configuration"
              action="action_bpro_tds_regime_config"/>

</odoo>
