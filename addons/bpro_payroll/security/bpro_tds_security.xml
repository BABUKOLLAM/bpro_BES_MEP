<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- bpro.tds.declaration and bpro.tds.form16 had no ir.rule at all -
         access was gated only by native hr.group_hr_user/hr.group_hr_manager
         (see ir.model.access.csv), which is not company-scoped. Any
         client's HR Admin (bpro_base.group_client_hr implies
         hr.group_hr_user) could read/write every other client company's
         employee TDS declarations and Form16 records. Follows the same
         three-tier company/super-admin pattern used everywhere else in
         this codebase (see bpro_base/security/bpro_security.xml). -->

    <record id="rule_tds_declaration_own_company" model="ir.rule">
        <field name="name">bpro TDS Declaration: Own Company</field>
        <field name="model_id" ref="model_bpro_tds_declaration"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[('contract_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_tds_declaration_super_admin_all" model="ir.rule">
        <field name="name">bpro TDS Declaration: Super Admin All</field>
        <field name="model_id" ref="model_bpro_tds_declaration"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_tds_form16_own_company" model="ir.rule">
        <field name="name">bpro TDS Form16: Own Company</field>
        <field name="model_id" ref="model_bpro_tds_form16"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_tds_form16_super_admin_all" model="ir.rule">
        <field name="name">bpro TDS Form16: Super Admin All</field>
        <field name="model_id" ref="model_bpro_tds_form16"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
