<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_billing_plan_list" model="ir.ui.view">
        <field name="name">bpro.billing.plan.list</field>
        <field name="model">bpro.billing.plan</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="price_per_seat"/>
                <field name="period"/>
                <field name="currency_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_billing_subscription_list" model="ir.ui.view">
        <field name="name">bpro.billing.subscription.list</field>
        <field name="model">bpro.billing.subscription</field>
        <field name="arch" type="xml">
            <list>
                <field name="client_company_id"/>
                <field name="plan_id"/>
                <field name="seats"/>
                <field name="amount"/>
                <field name="next_invoice_date"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'trial'"
                       decoration-danger="state == 'suspended'"/>
            </list>
        </field>
    </record>

    <record id="view_billing_subscription_form" model="ir.ui.view">
        <field name="name">bpro.billing.subscription.form</field>
        <field name="model">bpro.billing.subscription</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object"
                            class="btn-primary" invisible="state in ('active', 'cancelled')"/>
                    <button name="action_invoice_now" string="Invoice Now" type="object"
                            invisible="state not in ('trial', 'active')"/>
                    <button name="action_suspend" string="Suspend" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'cancelled'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="client_company_id"/>
                            <field name="plan_id"/>
                            <field name="seats"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="next_invoice_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_billing_plan" model="ir.actions.act_window">
        <field name="name">Plans</field>
        <field name="res_model">bpro.billing.plan</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_billing_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">bpro.billing.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_billing_root" name="Billing" parent="bpro_pms.menu_pms_root"
              sequence="88" groups="bpro_base.group_super_admin"/>
    <menuitem id="menu_billing_subscriptions" name="Subscriptions" parent="menu_billing_root"
              action="action_billing_subscription" sequence="10"/>
    <menuitem id="menu_billing_plans" name="Plans" parent="menu_billing_root"
              action="action_billing_plan" sequence="20"/>
</odoo>
