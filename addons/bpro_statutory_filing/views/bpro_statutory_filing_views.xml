<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="bpro_statutory_filing_view_form" model="ir.ui.view">
        <field name="name">bpro.statutory.filing.form</field>
        <field name="model">bpro.statutory.filing</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <p>
                        Generates the monthly compliance files from that month's
                        <b>confirmed</b> payslips: EPFO ECR, ESIC contribution,
                        PT summary per state, Form 24Q quarterly TDS data, and the
                        bank salary advice. Employees missing a required identifier
                        (UAN / ESI number / PAN / bank account) are excluded from
                        that file and listed in the summary.
                    </p>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="month"/>
                            <field name="year"/>
                        </group>
                    </group>
                    <group string="Generated Files" invisible="not summary">
                        <field name="ecr_file" filename="ecr_filename"/>
                        <field name="ecr_filename" invisible="1"/>
                        <field name="esic_file" filename="esic_filename"/>
                        <field name="esic_filename" invisible="1"/>
                        <field name="pt_file" filename="pt_filename"/>
                        <field name="pt_filename" invisible="1"/>
                        <field name="tds_file" filename="tds_filename"/>
                        <field name="tds_filename" invisible="1"/>
                        <field name="bank_file" filename="bank_filename"/>
                        <field name="bank_filename" invisible="1"/>
                    </group>
                    <field name="summary" readonly="1" invisible="not summary"/>
                </sheet>
                <footer>
                    <button name="action_generate" string="Generate Filings" type="object" class="oe_highlight"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bpro_statutory_filing" model="ir.actions.act_window">
        <field name="name">Statutory Filings</field>
        <field name="res_model">bpro.statutory.filing</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bpro_statutory_filing" name="Statutory Filings"
              parent="payroll.payroll_menu_root"
              action="action_bpro_statutory_filing" sequence="50"
              groups="payroll.group_payroll_user"/>

</odoo>
