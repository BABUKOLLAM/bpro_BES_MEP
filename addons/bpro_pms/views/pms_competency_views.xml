<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pms_competency_list" model="ir.ui.view">
        <field name="name">bpro.pms.competency.list</field>
        <field name="model">bpro.pms.competency</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="training_need_count" string="Open Needs"/>
            </list>
        </field>
    </record>

    <record id="view_pms_competency_form" model="ir.ui.view">
        <field name="name">bpro.pms.competency.form</field>
        <field name="model">bpro.pms.competency</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Sales Excellence"/></h1>
                    </div>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pms_competency" model="ir.actions.act_window">
        <field name="name">Competencies</field>
        <field name="res_model">bpro.pms.competency</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_pms_training_need_list" model="ir.ui.view">
        <field name="name">bpro.pms.training.need.list</field>
        <field name="model">bpro.pms.training.need</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="competency_id"/>
                <field name="appraisal_id"/>
                <field name="note"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'enrolled'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="action_pms_training_need" model="ir.actions.act_window">
        <field name="name">Training Needs</field>
        <field name="res_model">bpro.pms.training.need</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Training Needs tab on the appraisal -->
    <record id="view_pms_appraisal_form_needs" model="ir.ui.view">
        <field name="name">bpro.pms.appraisal.form.needs</field>
        <field name="model">bpro.pms.appraisal</field>
        <field name="inherit_id" ref="view_pms_appraisal_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Training Needs">
                    <field name="training_need_ids"
                           context="{'default_employee_id': employee_id}">
                        <list editable="bottom">
                            <field name="employee_id" column_invisible="1"/>
                            <field name="competency_id"/>
                            <field name="note"/>
                            <field name="state" readonly="1" widget="badge"/>
                        </list>
                    </field>
                    <div class="text-muted">
                        Completing the appraisal enrolls the employee in the
                        courses linked to each competency.
                    </div>
                </page>
            </notebook>
        </field>
    </record>

    <!-- Employee 360 tab -->
    <record id="view_employee_form_360" model="ir.ui.view">
        <field name="name">hr.employee.form.bpro360</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="bpro 360">
                    <group>
                        <group>
                            <field name="pms_goal_progress"/>
                            <field name="pms_last_rating"/>
                        </group>
                    </group>
                    <separator string="Goals"/>
                    <field name="pms_goal_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="cycle_id"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <separator string="Appraisals"/>
                    <field name="pms_appraisal_ids" readonly="1">
                        <list>
                            <field name="cycle_id"/>
                            <field name="reviewer_id"/>
                            <field name="rating"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                    <separator string="Training Needs"/>
                    <field name="pms_training_need_ids" readonly="1">
                        <list>
                            <field name="competency_id"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <menuitem id="menu_pms_training_needs" name="Training Needs" parent="menu_pms_root"
              action="action_pms_training_need" sequence="30"/>
    <menuitem id="menu_pms_competencies" name="Competencies" parent="menu_pms_config"
              action="action_pms_competency" sequence="20"/>
</odoo>
