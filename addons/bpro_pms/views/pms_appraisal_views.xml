<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pms_appraisal_list" model="ir.ui.view">
        <field name="name">bpro.pms.appraisal.list</field>
        <field name="model">bpro.pms.appraisal</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="reviewer_id"/>
                <field name="cycle_id"/>
                <field name="rating"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_pms_appraisal_form" model="ir.ui.view">
        <field name="name">bpro.pms.appraisal.form</field>
        <field name="model">bpro.pms.appraisal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start_self" string="Start Self Assessment" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_submit_review" string="Submit for Review" type="object"
                            class="btn-primary" invisible="state != 'self'"/>
                    <button name="action_done" string="Complete" type="object"
                            class="btn-success" invisible="state != 'review'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="reviewer_id"/>
                        </group>
                        <group>
                            <field name="cycle_id"/>
                            <field name="rating"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Goals in Cycle">
                            <field name="goal_ids" readonly="1"/>
                        </page>
                        <page string="Self Assessment">
                            <field name="self_assessment"/>
                        </page>
                        <page string="Manager Feedback">
                            <field name="manager_feedback"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pms_appraisal" model="ir.actions.act_window">
        <field name="name">Appraisals</field>
        <field name="res_model">bpro.pms.appraisal</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
