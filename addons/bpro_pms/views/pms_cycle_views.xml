<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pms_cycle_list" model="ir.ui.view">
        <field name="name">bpro.pms.cycle.list</field>
        <field name="model">bpro.pms.cycle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="goal_count" string="Goals"/>
                <field name="appraisal_count" string="Appraisals"/>
                <field name="state" widget="badge" decoration-info="state == 'open'"/>
            </list>
        </field>
    </record>

    <record id="view_pms_cycle_form" model="ir.ui.view">
        <field name="name">bpro.pms.cycle.form</field>
        <field name="model">bpro.pms.cycle</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open" string="Open Cycle" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close Cycle" type="object"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. FY 2026 Q3"/></h1>
                    </div>
                    <group>
                        <field name="date_start"/>
                        <field name="date_end"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <notebook>
                        <page string="Goals">
                            <field name="goal_ids"/>
                        </page>
                        <page string="Appraisals">
                            <field name="appraisal_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pms_cycle" model="ir.actions.act_window">
        <field name="name">Review Cycles</field>
        <field name="res_model">bpro.pms.cycle</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
