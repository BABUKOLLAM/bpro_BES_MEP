<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Three-tier record rules (company / department / self) per roadmap section 6 -->

    <!-- Goals -->
    <record id="rule_pms_goal_self" model="ir.rule">
        <field name="name">PMS Goal: Self Only</field>
        <field name="model_id" ref="model_bpro_pms_goal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_pms_goal_hod" model="ir.rule">
        <field name="name">PMS Goal: Own Department</field>
        <field name="model_id" ref="model_bpro_pms_goal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_hod'))]"/>
        <field name="domain_force">[('employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_pms_goal_hr" model="ir.rule">
        <field name="name">PMS Goal: Own Company</field>
        <field name="model_id" ref="model_bpro_pms_goal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_client_hr'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pms_goal_super" model="ir.rule">
        <field name="name">PMS Goal: Super Admin All</field>
        <field name="model_id" ref="model_bpro_pms_goal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Appraisals -->
    <record id="rule_pms_appraisal_self" model="ir.rule">
        <field name="name">PMS Appraisal: Self or Reviewer</field>
        <field name="model_id" ref="model_bpro_pms_appraisal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_employee'))]"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('reviewer_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_pms_appraisal_hod" model="ir.rule">
        <field name="name">PMS Appraisal: Own Department</field>
        <field name="model_id" ref="model_bpro_pms_appraisal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_hod'))]"/>
        <field name="domain_force">[('employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_pms_appraisal_hr" model="ir.rule">
        <field name="name">PMS Appraisal: Own Company</field>
        <field name="model_id" ref="model_bpro_pms_appraisal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_client_hr'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pms_appraisal_super" model="ir.rule">
        <field name="name">PMS Appraisal: Super Admin All</field>
        <field name="model_id" ref="model_bpro_pms_appraisal"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Review cycles: company-scoped for everyone below super admin -->
    <record id="rule_pms_cycle_company" model="ir.rule">
        <field name="name">PMS Cycle: Own Company</field>
        <field name="model_id" ref="model_bpro_pms_cycle"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_employee'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pms_cycle_super" model="ir.rule">
        <field name="name">PMS Cycle: Super Admin All</field>
        <field name="model_id" ref="model_bpro_pms_cycle"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Competencies: own company + global (parent), like courses -->
    <record id="rule_pms_competency_company" model="ir.rule">
        <field name="name">PMS Competency: Own Company or Global</field>
        <field name="model_id" ref="model_bpro_pms_competency"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_employee'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'parent_of', [user.company_id.id])]</field>
    </record>

    <record id="rule_pms_competency_super" model="ir.rule">
        <field name="name">PMS Competency: Super Admin All</field>
        <field name="model_id" ref="model_bpro_pms_competency"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Training needs: same three-tier pattern as goals -->
    <record id="rule_pms_need_self" model="ir.rule">
        <field name="name">PMS Training Need: Self Only</field>
        <field name="model_id" ref="model_bpro_pms_training_need"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_pms_need_hod" model="ir.rule">
        <field name="name">PMS Training Need: Own Department</field>
        <field name="model_id" ref="model_bpro_pms_training_need"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_hod'))]"/>
        <field name="domain_force">[('employee_id.department_id.manager_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_pms_need_hr" model="ir.rule">
        <field name="name">PMS Training Need: Own Company</field>
        <field name="model_id" ref="model_bpro_pms_training_need"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_client_hr'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_pms_need_super" model="ir.rule">
        <field name="name">PMS Training Need: Super Admin All</field>
        <field name="model_id" ref="model_bpro_pms_training_need"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
