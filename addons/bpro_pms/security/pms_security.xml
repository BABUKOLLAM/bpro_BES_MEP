<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bpro_pms" model="ir.module.category">
        <field name="name">bpro PMS</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_pms_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_bpro_pms"/>
    </record>

    <record id="group_pms_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_bpro_pms"/>
        <field name="implied_ids" eval="[(4, ref('group_pms_user'))]"/>
    </record>

    <!-- Users see their own goals; managers see everything in their company -->
    <record id="rule_pms_goal_user" model="ir.rule">
        <field name="name">PMS Goal: own records</field>
        <field name="model_id" ref="model_bpro_pms_goal"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('manager_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pms_user'))]"/>
    </record>

    <record id="rule_pms_goal_manager" model="ir.rule">
        <field name="name">PMS Goal: manager all</field>
        <field name="model_id" ref="model_bpro_pms_goal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pms_manager'))]"/>
    </record>

    <record id="rule_pms_appraisal_user" model="ir.rule">
        <field name="name">PMS Appraisal: own records</field>
        <field name="model_id" ref="model_bpro_pms_appraisal"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('reviewer_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_pms_user'))]"/>
    </record>

    <record id="rule_pms_appraisal_manager" model="ir.rule">
        <field name="name">PMS Appraisal: manager all</field>
        <field name="model_id" ref="model_bpro_pms_appraisal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pms_manager'))]"/>
    </record>
</odoo>
