<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="report_job_offer_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Offer of Employment</h2>
                        <p>
                            Date: <span t-field="o.offer_date"/>
                        </p>
                        <p>
                            Dear <span t-field="o.applicant_id.partner_name"/>,
                        </p>
                        <p>
                            We are pleased to offer you the position of
                            <strong><span t-field="o.proposed_designation"/></strong>
                            at <span t-field="o.company_id.name"/>.
                        </p>
                        <table class="table table-sm table-bordered">
                            <tr>
                                <td><strong>Proposed CTC (Annual)</strong></td>
                                <td>
                                    <span t-esc="o.proposed_ctc" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Joining Date</strong></td>
                                <td><span t-field="o.joining_date"/></td>
                            </tr>
                        </table>
                        <p>
                            This offer is subject to the terms and conditions of
                            employment as per company policy. Please confirm your
                            acceptance through the link shared separately by email.
                        </p>
                        <p class="mt-5">
                            <strong>For <span t-field="o.company_id.name"/></strong>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_job_offer" model="ir.actions.report">
        <field name="name">Offer Letter</field>
        <field name="model">bpro.job.offer</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bpro_recruitment.report_job_offer_document</field>
        <field name="report_file">bpro_recruitment.report_job_offer_document</field>
        <field name="binding_model_id" ref="model_bpro_job_offer"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
