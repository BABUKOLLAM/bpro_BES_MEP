<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="hr_applicant_view_form_bpro_evaluations" model="ir.ui.view">
        <field name="name">hr.applicant.form.bpro.evaluations</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <page name="application_details" position="after">
                <page string="Interview Evaluations" name="bpro_interview_evaluations">
                    <field name="evaluation_ids">
                        <list editable="bottom">
                            <field name="interviewer_id"/>
                            <field name="interview_type"/>
                            <field name="interview_datetime"/>
                            <field name="marks"/>
                            <field name="recommendation"/>
                            <field name="remarks"/>
                        </list>
                    </field>
                </page>
            </page>
        </field>
    </record>

</odoo>
