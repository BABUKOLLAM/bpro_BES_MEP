<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_department" model="ir.ui.view">
        <field name="name">stock.picking.form.department</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="department_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="stock_picking_search_department" model="ir.ui.view">
        <field name="name">stock.picking.search.department</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="department_id"/>
                <filter name="gb_bpro_department" string="Ordering Department"
                        context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>
</odoo>
