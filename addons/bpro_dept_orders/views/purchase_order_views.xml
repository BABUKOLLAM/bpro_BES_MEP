<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_department" model="ir.ui.view">
        <field name="name">purchase.order.form.department</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="department_id"/>
            </field>
        </field>
    </record>

    <record id="purchase_order_search_department" model="ir.ui.view">
        <field name="name">purchase.order.search.department</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.view_purchase_order_filter"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="department_id"/>
                <filter name="gb_bpro_department" string="Ordering Department"
                        context="{'group_by': 'department_id'}"/>
            </search>
        </field>
    </record>
</odoo>
