<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_company_view_form_bpro_exit" model="ir.ui.view">
        <field name="name">res.company.form.bpro.exit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Exit — Separation Policy" name="bpro_exit_policy">
                    <group>
                        <field name="exit_notice_days"/>
                        <field name="gratuity_cap"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
