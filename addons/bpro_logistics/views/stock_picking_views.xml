<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_bpro_vendor_performance" model="ir.ui.view">
        <field name="name">stock.picking.form.bpro.vendor.performance</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_done']" position="after">
                <field name="bpro_promised_date"
                       invisible="state != 'done' or not purchase_id"/>
                <field name="bpro_delay_days"
                       invisible="state != 'done' or not purchase_id"/>
                <field name="bpro_on_time"
                       invisible="state != 'done' or not purchase_id"/>
            </xpath>
        </field>
    </record>

    <record id="view_bpro_vendor_performance_list" model="ir.ui.view">
        <field name="name">stock.picking.bpro.vendor.performance.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="purchase_id"/>
                <field name="bpro_promised_date"/>
                <field name="date_done"/>
                <field name="bpro_delay_days" avg="Avg Delay (days)"/>
                <field name="bpro_on_time"/>
            </list>
        </field>
    </record>

    <record id="view_bpro_vendor_performance_pivot" model="ir.ui.view">
        <field name="name">stock.picking.bpro.vendor.performance.pivot</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="partner_id" type="row"/>
                <field name="bpro_delay_days" type="measure"/>
                <field name="bpro_on_time" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_bpro_vendor_performance" model="ir.actions.act_window">
        <field name="name">Vendor Delivery Performance</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">pivot,list</field>
        <field name="domain">[("state", "=", "done"), ("purchase_id", "!=", False)]</field>
    </record>

    <menuitem id="menu_bpro_vendor_performance" name="Vendor Delivery Performance"
              parent="stock.menu_warehouse_report" action="action_bpro_vendor_performance"
              groups="stock.group_stock_manager" sequence="20"/>
</odoo>
