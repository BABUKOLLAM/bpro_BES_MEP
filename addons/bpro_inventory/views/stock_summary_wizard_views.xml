<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpro_stock_summary_wizard_form" model="ir.ui.view">
        <field name="name">bpro.stock.summary.wizard.form</field>
        <field name="model">bpro.stock.summary.wizard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button name="action_export_xlsx" type="object" string="Export to Excel"
                            invisible="not line_ids"/>
                </header>
                <sheet>
                    <group>
                        <field name="as_of_date"/>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="product_id"/>
                            <field name="location_id"/>
                            <field name="quantity" sum="Total"/>
                            <field name="uom_id"/>
                            <field name="unit_cost"/>
                            <field name="value" sum="Total"/>
                        </list>
                    </field>
                    <group col="4">
                        <field name="total_value"/>
                    </group>
                    <group string="Excel export columns" invisible="not line_ids">
                        <field name="xlsx_column_ids" widget="many2many_tags" nolabel="1"
                               domain="[('report_model', '=', 'bpro.stock.summary.wizard')]"/>
                    </group>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bpro_stock_summary_wizard" model="ir.actions.act_window">
        <field name="name">Stock Summary</field>
        <field name="res_model">bpro.stock.summary.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_bpro_stock_summary" name="Stock Summary"
              parent="stock.menu_warehouse_report"
              action="action_bpro_stock_summary_wizard" sequence="10"/>
</odoo>
