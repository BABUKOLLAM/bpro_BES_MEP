<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_warehouse_orderpoint_form_bpro" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.form.bpro</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_form"/>
        <field name="arch" type="xml">
            <field name="qty_multiple" position="after">
                <group string="Suggested Reorder Levels">
                    <field name="bpro_lookback_days"/>
                    <field name="bpro_avg_daily_demand" readonly="1"/>
                    <field name="bpro_suggested_min_qty" readonly="1"/>
                    <field name="bpro_suggested_max_qty" readonly="1"/>
                    <button name="action_bpro_apply_suggested_levels" type="object"
                            string="Apply Suggested Levels" class="btn-secondary"/>
                </group>
            </field>
        </field>
    </record>

    <record id="view_warehouse_orderpoint_tree_editable_bpro" model="ir.ui.view">
        <field name="name">stock.warehouse.orderpoint.list.editable.bpro</field>
        <field name="model">stock.warehouse.orderpoint</field>
        <field name="inherit_id" ref="stock.view_warehouse_orderpoint_tree_editable"/>
        <field name="arch" type="xml">
            <field name="product_max_qty" position="after">
                <field name="bpro_suggested_min_qty" optional="hide" string="Suggested Min"/>
                <field name="bpro_suggested_max_qty" optional="hide" string="Suggested Max"/>
                <button name="action_bpro_apply_suggested_levels" type="object"
                        string="Apply Suggested" class="btn-link"/>
            </field>
        </field>
    </record>
</odoo>
