<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_stock_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h2>Stock Summary</h2>
                            <h5 class="text-muted">As of <span t-esc="o.as_of_date"/></h5>
                        </div>
                        <table class="table table-sm table-borderless" style="font-size:11px;">
                            <thead>
                                <tr style="border-bottom: 1px solid #333;">
                                    <th>Product</th>
                                    <th>Location</th>
                                    <th class="text-end">Quantity</th>
                                    <th>UoM</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="text-end">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.line_ids" t-as="l">
                                    <td t-esc="l.product_id.display_name"/>
                                    <td t-esc="l.location_id.complete_name"/>
                                    <td class="text-end" t-esc="'%.2f' % l.quantity"/>
                                    <td t-esc="l.uom_id.name"/>
                                    <td class="text-end" t-esc="'%.2f' % l.unit_cost"/>
                                    <td class="text-end" t-esc="'%.2f' % l.value"/>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr style="border-top: 2px solid #333; font-weight: bold;">
                                    <td colspan="5">Total</td>
                                    <td class="text-end" t-esc="'%.2f' % o.total_value"/>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_stock_summary" model="ir.actions.report">
        <field name="name">Stock Summary PDF</field>
        <field name="model">bpro.stock.summary.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bpro_inventory.report_stock_summary</field>
        <field name="report_file">bpro_inventory.report_stock_summary</field>
        <field name="print_report_name">'Stock Summary - %s' % (object.as_of_date)</field>
        <field name="binding_model_id" ref="model_bpro_stock_summary_wizard"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
