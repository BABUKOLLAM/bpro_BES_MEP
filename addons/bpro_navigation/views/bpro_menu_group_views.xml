<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_bpro_menu_group_list" model="ir.ui.view">
        <field name="name">bpro.menu.group.list</field>
        <field name="model">bpro.menu.group</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_fallback"/>
                <field name="menu_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_bpro_menu_group_form" model="ir.ui.view">
        <field name="name">bpro.menu.group.form</field>
        <field name="model">bpro.menu.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="is_fallback"/>
                    </group>
                    <field name="menu_ids"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bpro_menu_group" model="ir.actions.act_window">
        <field name="name">bpro App Groups</field>
        <field name="res_model">bpro.menu.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bpro_menu_group"
        name="bpro App Groups"
        action="action_bpro_menu_group"
        parent="base.menu_custom"
        sequence="99"
        groups="base.group_system"/>
</odoo>
