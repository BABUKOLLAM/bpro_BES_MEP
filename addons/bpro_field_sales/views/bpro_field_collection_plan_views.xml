<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpro_field_collection_plan_list" model="ir.ui.view">
        <field name="name">bpro.field.collection.plan.list</field>
        <field name="model">bpro.field.collection.plan</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'collected'"
                  decoration-warning="state == 'partial'"
                  decoration-danger="state == 'missed'">
                <field name="planned_date"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="partner_outstanding"/>
                <field name="expected_amount"/>
                <field name="collected_amount"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bpro_field_collection_plan_form" model="ir.ui.view">
        <field name="name">bpro.field.collection.plan.form</field>
        <field name="model">bpro.field.collection.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm_collection" string="Confirm Collection"
                            type="object" class="btn-primary" invisible="state != 'planned'"/>
                    <button name="action_mark_missed" string="Mark Missed" type="object"
                            class="btn-secondary" invisible="state != 'planned'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="planned,collected,partial,missed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="partner_id"/>
                            <field name="planned_date"/>
                            <field name="partner_outstanding"/>
                        </group>
                        <group>
                            <field name="expected_amount"/>
                            <field name="collected_amount"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bpro_field_collection_plan" model="ir.actions.act_window">
        <field name="name">Field Collection Plan</field>
        <field name="res_model">bpro.field.collection.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bpro_field_collection_plan" name="Field Collection Plan"
              parent="crm.crm_menu_root" action="action_bpro_field_collection_plan"
              sequence="26"/>
</odoo>
