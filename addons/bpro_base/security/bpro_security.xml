<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bpro" model="ir.module.category">
        <field name="name">bpro LMS + PMS</field>
        <field name="sequence">25</field>
    </record>

    <!-- Four-tier role model (roadmap section 3) -->
    <record id="group_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="category_id" ref="module_category_bpro"/>
        <field name="comment">Self-service: own courses, own goals, own appraisal.</field>
    </record>

    <record id="group_hod" model="res.groups">
        <field name="name">Head of Department</field>
        <field name="category_id" ref="module_category_bpro"/>
        <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
        <field name="comment">Own department's employees only: assign, track, approve.</field>
    </record>

    <record id="group_client_hr" model="res.groups">
        <field name="name">Client HR Admin</field>
        <field name="category_id" ref="module_category_bpro"/>
        <!-- hr.group_hr_user gives real hr.employee access; the bpro
             record rules still scope it to their own company -->
        <field name="implied_ids" eval="[(4, ref('group_hod')), (4, ref('hr.group_hr_user'))]"/>
        <field name="comment">Full access within their own company only.</field>
    </record>

    <record id="group_super_admin" model="res.groups">
        <field name="name">bpro Super Admin</field>
        <field name="category_id" ref="module_category_bpro"/>
        <field name="implied_ids" eval="[(4, ref('group_client_hr'))]"/>
        <field name="comment">All companies, all data, client onboarding.</field>
    </record>

    <!-- Three-tier record rules on hr.employee (roadmap section 3.3) -->
    <record id="rule_employee_self_only" model="ir.rule">
        <field name="name">bpro Employee: Self Only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_employee'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_hod_own_department" model="ir.rule">
        <field name="name">bpro HOD: Own Department Only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_hod'))]"/>
        <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_hr_own_company" model="ir.rule">
        <field name="name">bpro HR: Own Company Only</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_client_hr'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_super_admin_all" model="ir.rule">
        <field name="name">bpro Super Admin: All Companies</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- Same three-tier pattern on the public employee directory
         (hr.employee.public), which Odoo serves to non-HR users. -->
    <record id="rule_employee_public_self" model="ir.rule">
        <field name="name">bpro Employee Directory: Self Only</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="groups" eval="[(4, ref('group_employee'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>

    <record id="rule_employee_public_hod" model="ir.rule">
        <field name="name">bpro Employee Directory: Own Department</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="groups" eval="[(4, ref('group_hod'))]"/>
        <field name="domain_force">[('department_id.manager_id.user_id', '=', user.id)]</field>
    </record>

    <record id="rule_employee_public_hr" model="ir.rule">
        <field name="name">bpro Employee Directory: Own Company</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="groups" eval="[(4, ref('group_client_hr'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_employee_public_super" model="ir.rule">
        <field name="name">bpro Employee Directory: Super Admin All</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="groups" eval="[(4, ref('group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
