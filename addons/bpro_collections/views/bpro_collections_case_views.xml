<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpro_collections_case_list" model="ir.ui.view">
        <field name="name">bpro.collections.case.list</field>
        <field name="model">bpro.collections.case</field>
        <field name="arch" type="xml">
            <list decoration-warning="level == 'reminder'" decoration-danger="level in ('firm', 'final')">
                <field name="partner_id"/>
                <field name="overdue_amount"/>
                <field name="oldest_overdue_date"/>
                <field name="days_overdue"/>
                <field name="level"/>
                <field name="assigned_to"/>
                <field name="next_action_date"/>
                <field name="state"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_bpro_collections_case_form" model="ir.ui.view">
        <field name="name">bpro.collections.case.form</field>
        <field name="model">bpro.collections.case</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_refresh" string="Refresh" type="object"/>
                    <button name="action_record_contact" string="Record Contact"
                            type="object" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_close" string="Close" type="object"
                            invisible="state != 'open'"/>
                    <button name="action_reopen" string="Reopen" type="object"
                            invisible="state != 'closed'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="overdue_amount"/>
                            <field name="oldest_overdue_date"/>
                            <field name="days_overdue"/>
                            <field name="level"/>
                        </group>
                        <group>
                            <field name="assigned_to"/>
                            <field name="last_contacted_date"/>
                            <field name="next_action_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bpro_collections_case" model="ir.actions.act_window">
        <field name="name">Collections</field>
        <field name="res_model">bpro.collections.case</field>
        <field name="view_mode">list,form</field>
        <field name="context">{"search_default_open": 1}</field>
    </record>

    <record id="view_bpro_collections_case_search" model="ir.ui.view">
        <field name="name">bpro.collections.case.search</field>
        <field name="model">bpro.collections.case</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="assigned_to"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_level" string="Level" context="{'group_by': 'level'}"/>
                    <filter name="group_assigned" string="Assigned To" context="{'group_by': 'assigned_to'}"/>
                </group>
            </search>
        </field>
    </record>

    <menuitem id="menu_bpro_collections_case" name="Collections"
              parent="account.menu_finance_receivables" action="action_bpro_collections_case"
              groups="account.group_account_invoice" sequence="15"/>
</odoo>
