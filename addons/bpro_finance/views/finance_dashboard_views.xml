<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bpro_finance_dashboard_form" model="ir.ui.view">
        <field name="name">bpro.finance.dashboard.form</field>
        <field name="model">bpro.finance.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="as_of_date"/>
                </group>
                <group col="4">
                    <field name="cash_position" widget="monetary"/>
                    <field name="total_receivables" widget="monetary"/>
                    <field name="total_payables" widget="monetary"/>
                    <field name="current_ratio"/>
                </group>
                <field name="currency_id" invisible="1"/>
            </form>
        </field>
    </record>

    <record id="action_bpro_finance_dashboard" model="ir.actions.act_window">
        <field name="name">Financial Dashboard</field>
        <field name="res_model">bpro.finance.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{}</field>
    </record>

    <menuitem id="menu_bpro_finance_dashboard" name="Financial Dashboard"
              parent="account.menu_finance_reports"
              action="action_bpro_finance_dashboard" sequence="1"/>
</odoo>
