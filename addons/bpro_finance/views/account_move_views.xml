<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_bpro_match" model="ir.ui.view">
        <field name="name">account.move.form.bpro.match</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header" position="inside">
                <field name="approval_state" invisible="1"/>
                <button name="action_approve" type="object" string="Approve Match"
                        invisible="approval_state != 'pending'" class="btn-primary"
                        groups="account.group_account_manager"/>
                <button name="action_reject" type="object" string="Reject Match"
                        invisible="approval_state != 'pending'"
                        groups="account.group_account_manager"/>
            </xpath>
            <xpath expr="//form/header" position="after">
                <div class="alert alert-warning" role="alert"
                     invisible="not bpro_match_mismatch">
                    <field name="bpro_match_mismatch" readonly="1" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
