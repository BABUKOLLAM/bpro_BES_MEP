<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bpro_tally_export_batch_multi_company" model="ir.rule">
        <field name="name">bpro Tally Export Batch: multi-company</field>
        <field name="model_id" ref="model_bpro_tally_export_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_bpro_tally_import_batch_multi_company" model="ir.rule">
        <field name="name">bpro Tally Import Batch: multi-company</field>
        <field name="model_id" ref="model_bpro_tally_import_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_bpro_tally_import_exception_multi_company" model="ir.rule">
        <field name="name">bpro Tally Import Exception: multi-company</field>
        <field name="model_id" ref="model_bpro_tally_import_exception"/>
        <field name="domain_force">[('batch_id.company_id', 'in', company_ids)]</field>
    </record>
</odoo>
