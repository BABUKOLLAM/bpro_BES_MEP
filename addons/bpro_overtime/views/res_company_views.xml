<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_company_view_form_bpro_overtime" model="ir.ui.view">
        <field name="name">res.company.form.bpro.overtime</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="HR — Overtime Policy" name="bpro_overtime_policy">
                    <group>
                        <field name="ot_compensation"/>
                        <field name="ot_multiplier" invisible="ot_compensation != 'pay'"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
