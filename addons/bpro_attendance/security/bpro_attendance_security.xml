<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="rule_attendance_exception_hr_own_company" model="ir.rule">
        <field name="name">bpro Attendance Exception: HR Own Company</field>
        <field name="model_id" ref="model_bpro_attendance_exception"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_client_hr'))]"/>
        <field name="domain_force">[('employee_id.company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_attendance_exception_super_admin_all" model="ir.rule">
        <field name="name">bpro Attendance Exception: Super Admin All</field>
        <field name="model_id" ref="model_bpro_attendance_exception"/>
        <field name="groups" eval="[(4, ref('bpro_base.group_super_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

</odoo>
