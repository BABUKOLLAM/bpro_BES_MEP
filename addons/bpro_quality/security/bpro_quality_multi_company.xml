<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_bpro_quality_point_multi_company" model="ir.rule">
        <field name="name">bpro Quality Checkpoint: multi-company</field>
        <field name="model_id" ref="model_bpro_quality_point"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_bpro_quality_check_multi_company" model="ir.rule">
        <field name="name">bpro Quality Check: multi-company</field>
        <field name="model_id" ref="model_bpro_quality_check"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_bpro_quality_nonconformance_multi_company" model="ir.rule">
        <field name="name">bpro Quality Non-Conformance: multi-company</field>
        <field name="model_id" ref="model_bpro_quality_nonconformance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
